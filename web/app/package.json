{
  "name": "mediaverse-web",
  "license": "GPL-3.0-or-later",
  "private": true,
  "version": "0.9.1",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "electron:start": "electron .",
    "sidecar:build": "cargo build -p mediaverse_sidecar --manifest-path ../../Cargo.toml",
    "test:electron": "node --test \"electron/**/*.test.js\"",
    "test": "tsc --noEmit && npm run test:unit",
    "test:unit": "node --test \"src/**/*.test.ts\" \"tv/**/*.test.ts\" \"phone/**/*.test.ts\"",
    "tv:build": "tsc --noEmit && vite build --config vite.tv.config.ts",
    "tv:dev": "vite --config vite.tv.config.ts",
    "phone:build": "tsc --noEmit && vite build --config vite.phone.config.ts",
    "phone:dev": "vite --config vite.phone.config.ts",
    "capture:drive-setup": "electron scripts/capture-drive-setup.cjs"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}



