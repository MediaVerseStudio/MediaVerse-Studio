<Project Sdk="Microsoft.NET.Sdk">

  <!-- MediaVerse Studio's Jellyfin plugin (test version). GPL-3.0-or-later, as the Jellyfin libraries it builds on
       are GPL. Built for one Jellyfin version at a time: change both package versions and targetAbi (build script)
       together when the server moves on. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MediaVerse.Jellyfin</RootNamespace>
    <Version>0.1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- The server provides these at run time: not copied into the plugin. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.4.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="settings.html" />
  </ItemGroup>

</Project>
